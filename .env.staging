# 预发布环境
VITE_APP_ENV = staging

# API 接口基础请求地址
VITE_API_BASE_URL = https://staging

# 是否移除 console 输出
VITE_BUILD_DROP_CONSOLE = true

# 是否移除 debugger 语句
VITE_BUILD_DROP_DEBUGGER = true

# 是否生成 sourcemap 映射文件
VITE_BUILD_SOURCEMAP = false

# 是否启用 mock 数据
VITE_USE_MOCK = false

# 服务器端口
VITE_SERVER_PORT = 8081
