# 测试环境
VITE_APP_ENV = test

# API 接口基础请求地址
VITE_API_BASE_URL = https://test

# 服务器端口
VITE_SERVER_PORT = 8081

# 是否自动打开浏览器
VITE_SERVER_OPEN = false

# 是否启用 mock 数据
VITE_USE_MOCK = false

# 是否生成 sourcemap 映射文件
VITE_BUILD_SOURCEMAP = true

# 是否移除 console 输出
VITE_BUILD_DROP_CONSOLE = false

# 是否移除 debugger 语句
VITE_BUILD_DROP_DEBUGGER = false
