{

  "editor.formatOnSave": true,
  // * 编辑器核心设置
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit", // 保存时自动修复ESLint错误
    "source.organizeImports": "never" // 禁止保存时自动整理导入语句
  },
  // * 代码质量与格式化
  "eslint.useFlatConfig": true, // 使用扁平配置文件
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "eslint.config.*": ".editorconfig, lint-staged.config.js, commitlint.config.js",
    "tsconfig.json": "tsconfig.*.json, env.d.ts",
    "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*",
    "package.json": "bun.lock,.gitattributes,.gitignore,.node-version"
  },
  "cSpell.words": [
    "bunx",
    "commitlint",
    "oneline",
    "persistedstate",
    "unplugin"
  ]
}
